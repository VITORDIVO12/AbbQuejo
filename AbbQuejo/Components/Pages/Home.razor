@page  "/"

<div>

    <h1>comente algo sobre a imagem na tela</h1>

    <img src="/imagens/14673019.png" width="550" />

    <p ">O que acha de vinland Saga?</p>

    <input @bind="comentario" type="text" maxlength="300"/>
