}

@code{
    string comentario = "";
    DateTime dataAtual;
    string teste;
    List<string> lista = new List<string>();

    void Enviar()
    {
        //teste = "Botão funciona";
        dataAtual = DateTime.Now;
        lista.Add(comentario + "-" + dataAtual);
        comentario = "";
       


    }


}

